{
  "private": true,
  "name": "flux-monorepo",
  "version": "0.11.0",
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "postinstall": "patch-package",
    "clean": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' + && rm -f pnpm-lock.yaml && pnpm store prune",
    "bump-flux": "node scripts/monorepo-version.js bump",
    "bump-ad4m": "node scripts/monorepo-version.js bump-ad4m",
    "publish:dry-run": "node scripts/monorepo-version.js dry-run",
    "publish:all": "node scripts/monorepo-version.js publish",
    "format": "prettier --write .",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.16.0"
  },
  "dependencies": {
    "graphql": "^15.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "eslint-config-custom": "*",
    "patch-package": "*",
    "prettier": "latest",
    "prettier-plugin-sort-package-json": "latest",
    "turbo": "latest"
  },
  "pnpm": {
    "overrides": {
      "@coasys/ad4m-vue-hooks": "0.12.0",
      "@coasys/ad4m-react-hooks": "0.12.0",
      "@coasys/hooks-helpers": "0.12.0",
      "@preact/preset-vite": "2.9.4",
      "@coasys/flux-api": "workspace:*",
      "@coasys/flux-comment-section": "workspace:*",
      "@coasys/flux-constants": "workspace:*",
      "@coasys/flux-container": "workspace:*",
      "@coasys/flux-editor": "workspace:*",
      "@coasys/flux-react-web": "workspace:*",
      "@coasys/flux-types": "workspace:*",
      "@coasys/flux-ui": "workspace:*",
      "@coasys/flux-utils": "workspace:*",
      "@coasys/flux-vue": "workspace:*",
      "@coasys/flux-webrtc": "workspace:*",
      "@coasys/ad4m": "file:./ad4m/core",
      "@coasys/ad4m-connect": "file:./ad4m/connect"
    }
  }
}
